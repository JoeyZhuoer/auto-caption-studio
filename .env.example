# Copy to .env, or simply save your settings from the application.
# .env is ignored by Git so your key cannot be committed accidentally.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_USER_PROMPT=
UI_LANGUAGE=en
DOWNLOAD_DISCLAIMER_ACKNOWLEDGED=0
